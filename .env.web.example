# URL de la API .NET que usa el SERVIDOR de Next (nunca el navegador).
#   Local (npm run dev):   http://localhost:8081
#   Docker compose:        http://api:8080
# Vacio = modo demostracion: catalogo de muestra y tienda local (cuentas, carrito y pagos simulados, sin API).
# Opcional en demostracion: FLORAVIA_DEMO_DATA=/ruta/tienda.json (por defecto .demo-data/tienda.json).
FLORAVIA_API_URL=

# Cookies de sesion con atributo Secure. Produccion (HTTPS): vacio o "true". "false" solo para probar por HTTP.
FLORAVIA_COOKIE_SECURE=

# Contacto comercial (reemplazar por los datos reales del cliente)
NEXT_PUBLIC_WHATSAPP=5930000000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
