# Copia este archivo como ".env" (sin .example) y completa los valores. El archivo ".env" NO se sube a Git.

# ───── Base de datos ─────
POSTGRES_DB=floravia
POSTGRES_USER=floravia_user
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5432

# ───── API ─────
API_PORT=8081
# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres. Genera una con:  openssl rand -base64 48
JWT_KEY=
# URL del frontend (CORS y enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# Primer administrador: se crea al arrancar SOLO si todavía no existe ninguno. Cambia la clave después de entrar.
ADMIN_CORREO=admin@tutienda.com
ADMIN_PASSWORD=

# ───── Datos que se muestran al elegir "Transferencia" ─────
PAGO_BANCO=
PAGO_TIPO_CUENTA=
PAGO_NUMERO_CUENTA=
PAGO_TITULAR=
PAGO_IDENTIFICACION=

# ───── Correo (opcional). Sin SMTP_HOST no se envían correos de recuperación de contraseña ─────
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
